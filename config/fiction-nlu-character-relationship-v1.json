{
  "schema_version": "fiction_nlu_character_relationship_config_v1",
  "config_version": "fiction_nlu_character_relationship_v1",
  "assertion_scope": "evidence_window_relationship_assertion_not_global_truth",
  "principles": [
    "Relationship extraction consumes validated NLU-2 entities and mentions; it never creates or renames character entities.",
    "Every active relationship assertion is local to an evidence window and must cite passage-local evidence tied to both entities.",
    "Multiple relation types may coexist for one entity pair.",
    "Missing or low-confidence evidence is not a negative relationship fact.",
    "Persistent social roles and dynamic affect/behavior are represented separately so NLU-4 can build timelines later.",
    "Symmetric relations use a canonical ordered entity pair; directed relations preserve source and target.",
    "Contradictory local assertions are retained with provenance instead of being silently collapsed.",
    "Retrieval admission remains closed until a later certified integration."
  ],
  "pair_candidate_policy": {
    "same_passage": true,
    "adjacent_passage_gap": 1,
    "max_pair_windows_per_novel": 512,
    "max_entities_per_window": 12,
    "require_both_entities_have_mentions": true,
    "prefer_same_scene": true,
    "min_candidates_per_group": 2,
    "max_candidates_per_group": 5,
    "lexical_hint_boost": 3,
    "default_candidate_score": 1
  },
  "evidence_policy": {
    "max_quotes_per_assertion": 3,
    "require_source_and_target_mention_coverage": true,
    "quote_must_be_exact_passage_substring": true,
    "active_requires_evidence": true
  },
  "provider_policy": {
    "request_version": "fiction_nlu_character_relationship_request_v1",
    "score_every_candidate": true,
    "bounded_completion_retries": 1,
    "think": false
  },
  "relation_groups": {
