{
  "name": "armed-academy-story-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/src/ui-server.mjs --open",
    "ui": "node server/src/ui-server.mjs --open",
    "test": "node tests/run-all.mjs",
    "launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File launcher.ps1",
    "test:data": "node server/src/tools/validate-json-codeblocks.mjs && node server/src/tools/validate-jsonl.mjs --all --strict",
    "test:mcp": "node tests/tools/mcp-contract.test.mjs",
    "bridge:dry-run": "node scripts/chatgpt-bridge-e2e-dry-run.mjs --dry-run --cleanup --include-settlement-fixture",
    "test:bridge:e2e": "node tests/mcp/mcp-chatgpt-bridge-e2e-dry-run.test.mjs",
    "test:phase22b": "node tests/phase22/phase22b-wrong-cast.test.mjs",
    "medical:preview": "node scripts/high-tech-medical-normalization-preview.mjs",
    "audit:sessions": "node scripts/external-brain-session-lifecycle-audit.mjs",
    "audit:sessions:phase3b": "node scripts/external-brain-session-phase3b-audit.mjs",
    "test:bridge:approval-readiness": "node tests/mcp/mcp-approval-queue-bridge-readiness.test.mjs",
    "mcp:http": "node server/src/mcp-http-server.mjs --config config/mcp-http.example.json",
    "mcp:tunnel": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-mcp-tunnel.ps1",
    "mcp:tunnel:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-mcp-tunnel.ps1 -Status",
    "test:mcp:tunnel": "node tests/mcp-tunnel-launcher.test.mjs",
    "maintenance:sync-engine-component-hashes": "node scripts/sync-engine-component-hashes.mjs",
    "maintenance:sync-active-engine-dependencies": "node scripts/sync-active-engine-dependencies.mjs",
    "test:phase62a": "node tests/phase62/phase62a-world-simulation-neural-bridge.test.mjs",
    "test:phase62b": "node tests/phase62/phase62b-shared-neural-core-dual-mode-isolation.test.mjs",
    "test:phase62c": "node tests/phase62/phase62c-world-simulation-main-loop-integration.test.mjs",
    "test:phase62d": "node tests/phase62/phase62d-programmatic-spatial-causal-rule-engine.test.mjs",
    "test:phase62e": "node tests/phase62/phase62e-programmatic-combat-causal-layer.test.mjs",
    "test:phase62f": "node tests/phase62/phase62f-continuous-projectile-ability-physics.test.mjs",
    "test:phase62g": "node tests/phase62/phase62g-unified-global-causal-timeline.test.mjs",
    "test:phase62h": "node tests/phase62/phase62h-dynamic-timeline-refinement.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
